/*Example Input Java:Python:JAVA:C:python:JavaScript:C 
Output: JAVA:PYTHON:C:JAVASCRIPT 
Explanation: The later occurrences of Java, Python, and C are removed because each word has already appeared. 
 */
import java.util.*;
public class q10removeduplicates {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String input = sc.nextLine().toLowerCase();
        String[] words = input.split(":");

        int n = words.length;

        for(int i=0; i<n-1; i++){
            for(int j=0; j<n-i-1; j++){
                if(words[j].compareTo(words[j+1])>0){
                    String temp = words[j];
                    words[j] = words[j+1];
                    words[j+1] = temp;
                }
            }
        }

        StringBuilder result = new StringBuilder();
        for(int i=0; i<n; i++){
            if(i==0 || !words[i].equals(words[i-1])){
                if(result.length() > 0){
                    result.append(":");
                }
                result.append(words[i].toUpperCase());
            }
        }
        System.out.println(result);
    }
}
