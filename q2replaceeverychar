/*Input c__e 
care:code:cake:cope:case:cheese 
Output CARE:CODE:CAKE:COPE:CASE 
Explanation: Every candidate must have four characters, start with c, and end with e. The two underscores can represent any two characters. 
 */
import java.util.*;
public class q2replaceeverychar {
    public static void main(String[] args) {
        
        Scanner sc = new Scanner(System.in);

        String pattern = sc.nextLine().toUpperCase();
        String dictionary = sc.nextLine().toUpperCase();

        String[] words = dictionary.split(":");

        StringBuilder result = new StringBuilder();

        for (String word : words) {

            if (word.length() == pattern.length()) {
                boolean match = true;

                for (int i = 0; i < pattern.length(); i++) {
                    if (pattern.charAt(i) != '_' &&
                        pattern.charAt(i) != word.charAt(i)) {

                            match = false;
                        break;
                    }
                }

                if (match) {
                    if (result.length() > 0) {
                        result.append(":");
                    }
                    result.append(word);
                }
            }
        }
        if (result.length() > 0) {
            System.out.println(result);
        } else {
            System.out.println("ERROR");
        }
        sc.close();
    }
}
