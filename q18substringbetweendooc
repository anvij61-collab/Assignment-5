/*Input ABABC 
BABCA 
Output BABC 
Explanation: BABC appears consecutively in both strings and has length four. No longer common consecutive substring exists. 
 */
import java.util.*;
public class q18substringbetweendooc {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String s1 = sc.nextLine();
        String s2 = sc.nextLine();

        int n = s1.length();
        int m = s2.length();

        int maxLen = 0;
        int startIndex = 0;

        for (int i = 0; i < n; i++) {

            for (int j = 0; j < m; j++) {

                int k = 0;

                while (i + k < n && j + k < m &&
                       s1.charAt(i + k) == s2.charAt(j + k)) {
                    k++;
                }

                if (k > maxLen) {
                    maxLen = k;
                    startIndex = i;
                }
            }
        }

        if (maxLen == 0) {
            System.out.println("NO-COMMON-SUBSTRING");
        } else {
            System.out.println(s1.substring(startIndex, startIndex + maxLen));
        }
    }
}
